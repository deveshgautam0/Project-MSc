def fetch_openlca_nexus():
    """openLCA Nexus -- LCA data repository (API if key available)."""
    df = _empty_df()
    api_key = os.getenv("OPENLCA_API_KEY")
    if not api_key:
        print("  [WARN] openLCA Nexus: OPENLCA_API_KEY not set -- skipping.")
        return df
    url = "https://nexus.openlca.org/api/search"
    resp = _safe_request(url, headers={"Authorization": f"Bearer {api_key}"})
    if resp is None:
        return df
    try:
        data = resp.json()
        rows = []
        for item in data:
            row = {
                "source": "literature",
                "reference": "openLCA Nexus",
            }
            for k in INPUT_FEATURES:
                row[k] = item.get(k, 0.0)
            for t in TARGET_COLS:
                row[t] = item.get(t, 0.0)
            rows.append(row)
        df = pd.DataFrame(rows, columns=ALL_COLS)
    except Exception as exc:  # noqa: BLE001
        print(f"  [WARN] openLCA Nexus: parse failed -- {exc}")
    return df


