# Registry: source name -> fetch function
FETCHERS = {
    "polynims": fetch_polynims,
    "polymergenome": fetch_polymergenome,
    "pubchem": fetch_pubchem,
    "chebi": fetch_chebi,
    "nanomine": fetch_nanomine,
    "materialsproject": fetch_materialsproject,
    "ecoinvent": fetch_ecoinvent,
    "openlca_nexus": fetch_openlca_nexus,
}


def fetch_all(limit_to=None):
    """Run every fetcher (or the named subset) and concatenate results."""
    frames = []
    targets = limit_to or list(FETCHERS.keys())
    for name in targets:
        if name not in FETCHERS:
            print(f"  [WARN] unknown source '{name}', skipping.")
            continue
        print(f"\n  ==> Fetching {name} ...")
        df = FETCHERS[name]()
        if len(df):
            frames.append(df)
            print(f"     -> {len(df)} rows fetched.")
        else:
            print(f"     -> 0 rows (source may need manual export / API key).")
    if not frames:
        return _empty_df()
    combined = pd.concat(frames, ignore_index=True)
    return combined


def save_csv(df, name="ingested_open_sources.csv"):
    RAW_DIR.mkdir(parents=True, exist_ok=True)
    out_path = RAW_DIR / name
    df.to_csv(out_path, index=False)
    print(f"\n  [OK] Wrote {len(df)} rows -> {out_path}")
    return out_path


def main():
    parser = argparse.ArgumentParser(
        description="Ingest open-source nanocomposite data."
    )
    parser.add_argument(
        "--source", nargs="+", help="Source key(s) to fetch (default: all)."
    )
    parser.add_argument(
        "--dry-run", action="store_true", help="List sources without fetching."
    )
    parser.add_argument(
        "--out", default="ingested_open_sources.csv", help="Output CSV filename."
    )
    args = parser.parse_args()

    if args.dry_run:
        print("Available sources:")
        for cat, sources in DATA_ACQUISITION_SOURCES.items():
            print(f"  {cat}:")
            for s, u in sources.items():
                print(f"    - {s}: {u}")
        return

    df = fetch_all(limit_to=args.source)
    if len(df):
        save_csv(df, args.out)
    else:
        print(
            "\n  [INFO] No data fetched. Use --dry-run to see sources, "
            "or export CSVs manually."
        )


if __name__ == "__main__":
    main()