def fetch_materialsproject():
    """Materials Project (Next-Gen) -- materials data (API key required)."""
    df = _empty_df()
    api_key = os.getenv("MATPROJECT_API_KEY")
    if not api_key:
        print("  [WARN] Materials Project: MATPROJECT_API_KEY not set -- skipping.")
        return df
    url = "https://next-gen.materialsproject.org/api/v1/materials/summary"
    resp = _safe_request(url, params={"api_key": api_key, "limit": 100})
    if resp is None:
        return df
    try:
        data = resp.json()
        rows = []
        for item in data.get("data", []):
            elements = item.get("elements", ["none"])
            row = {
                "matrix_polymer": "none",
                "agro_filler": "none",
                "nanoparticle": elements[0] if elements else "none",
                "source": "literature",
                "reference": "Materials Project API",
            }
            for k in INPUT_FEATURES:
                if k not in row:
                    row[k] = 0.0
            for t in TARGET_COLS:
                row[t] = 0.0
            rows.append(row)
        df = pd.DataFrame(rows, columns=ALL_COLS)
    except Exception as exc:  # noqa: BLE001
        print(f"  [WARN] Materials Project: parse failed -- {exc}")
    return df


